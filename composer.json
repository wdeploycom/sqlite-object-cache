{
    "name": "olliejones/sqlite-object-cache",
    "description": "A persistent object cache backend powered by SQLite3",
    "type": "wordpress-plugin",
    "keywords": ["wordpress", "cache", "sqlite", "performance", "apcu"],
    "homepage": "https://wordpress.org/plugins/sqlite-object-cache/",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Oliver Jones",
            "email": "oj@plumislandmedia.net",
            "homepage": "https://plumislandmedia.net"
        }
    ],
    "support": {
        "issues": "https://wordpress.org/support/plugin/sqlite-object-cache/",
        "source": "https://github.com/OllieJones/sqlite-object-cache"
    },
    "require": {
        "php": ">=8.3",
        "ext-sqlite3": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "yoast/phpunit-polyfills": "^4.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10",
        "phpmd/phpmd": "^2.14"
    },
    "suggest": {
        "ext-apcu": "For improved cache performance",
        "ext-igbinary": "For more efficient serialization"
    },
    "autoload-dev": {
        "psr-4": {
            "SQLiteObjectCache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": "phpunit --coverage-html tests/coverage/html",
        "phpcs": "phpcs --standard=WordPress includes/ sqlite-object-cache.php",
        "phpcbf": "phpcbf --standard=WordPress includes/ sqlite-object-cache.php",
        "phpstan": "phpstan analyse --level=5 includes/ sqlite-object-cache.php",
        "phpmd": "phpmd includes/,sqlite-object-cache.php text cleancode,codesize,controversial,design,naming,unusedcode",
        "qa": [
            "@phpcs",
            "@phpstan",
            "@phpmd",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}