<?xml version="1.0"?>
<ruleset name="SQLite Object Cache">
    <description>Coding standards for SQLite Object Cache plugin</description>

    <!-- Show progress and sniff codes -->
    <arg value="ps"/>
    
    <!-- Use colors -->
    <arg name="colors"/>
    
    <!-- Check PHP files only -->
    <arg name="extensions" value="php"/>
    
    <!-- Include the WordPress ruleset -->
    <rule ref="WordPress">
        <!-- Exclude rules that conflict with modern PHP -->
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="WordPress.PHP.DisallowShortTernary"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>
    
    <!-- Allow short array syntax -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    
    <!-- Check for PHP version compatibility -->
    <rule ref="PHPCompatibility"/>
    <config name="testVersion" value="8.3-"/>
    
    <!-- Files to check -->
    <file>includes/</file>
    <file>sqlite-object-cache.php</file>
    <file>assets/drop-in/object-cache.php</file>
    
    <!-- Exclude test files from WordPress standards -->
    <rule ref="WordPress">
        <exclude-pattern>tests/</exclude-pattern>
    </rule>
    
    <!-- Exclude vendor directory if it exists -->
    <exclude-pattern>vendor/</exclude-pattern>
    
    <!-- Exclude node_modules if it exists -->
    <exclude-pattern>node_modules/</exclude-pattern>
    
    <!-- Exclude coverage reports -->
    <exclude-pattern>tests/coverage/</exclude-pattern>
    
    <!-- WordPress specific rules -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="sqlite-object-cache"/>
        </properties>
    </rule>
    
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array" value="SQLite_Object_Cache,sqlite_object_cache"/>
        </properties>
    </rule>
    
    <!-- Allow some flexibility for test files -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>tests/</exclude-pattern>
    </rule>
    
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <exclude-pattern>tests/</exclude-pattern>
    </rule>
</ruleset>